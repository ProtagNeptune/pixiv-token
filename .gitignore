# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# VSCode 配置（如果你不想提交 IDE 设置）
.vscode/

# 虚拟环境目录
.venv/

# 环境变量和配置文件（如有）
.env
*.env

# pip 缓存
pip-wheel-metadata/

# 构建 / 发布产物
build/
dist/
*.egg-info/

# 测试缓存
.pytest_cache/

# 凭证缓存（避免误提交 token）
.pixiv-token/
.pixiv-token.json

# 日志文件
*.log

# macOS / Windows 系统文件
.DS_Store
Thumbs.db
